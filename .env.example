# Example environment variables for decidim-nyc.
# Only NYC-specific variables are listed here. For Rails, database, Decidim
# core and other standard variables, see config/database.yml,
# config/environments/production.rb, and decidim-core/lib/decidim/core.rb.

# -----------------------------------------------------------------------------
# NYC.ID SAML omniauth (custom strategy: lib/omniauth/strategies/nyc.rb)
# -----------------------------------------------------------------------------
# Provider is registered iff OMNIAUTH_NYC_PROVIDER_NAME is set. All values
# below are typically supplied by NYC.ID onboarding/metadata.
# OMNIAUTH_NYC_PROVIDER_NAME=NYC ID
# OMNIAUTH_NYC_ICON_PATH=               # Optional; falls back to `government-fill` Remix icon
# OMNIAUTH_NYC_CERT_FINGERPRINT=
# OMNIAUTH_NYC_CERT=                    # PEM cert content
# OMNIAUTH_NYC_KEY=                     # PEM private key content
# OMNIAUTH_NYC_ISSUER=
# OMNIAUTH_NYC_AUTHN_CONTEXT=
# OMNIAUTH_NYC_CALLBACK=                # assertion_consumer_service_url
# OMNIAUTH_NYC_SSO_CALLBACK_ORIGIN=     # Origin allowed for cross-site SAML callback (CSRF skip)
# OMNIAUTH_NYC_SSO_URL=                 # idp_sso_target_url
# OMNIAUTH_NYC_SLO_URL=                 # idp_slo_target_url

# -----------------------------------------------------------------------------
# NYC.ID button labels (rendered on the sign-in page)
# -----------------------------------------------------------------------------
# SIGN_IN_BUTTON_TEXT=Sign in with NYC.ID
# SIGN_UP_BUTTON_TEXT=Create account with NYC.ID
# SIGN_UP_BUTTON_NYID_URL=              # External NYC.ID registration URL
# SIGN_UP_BUTTON_SP_NAME=Decidim NYC    # Service Provider name passed as spName param
# SIGN_UP_BUTTON_TARGET=                # Post-registration target URL
