<% add_decidim_page_title(t(".title")) %>

<div class="card" id="airtable-import-configuration">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t(".title") %>
    </h1>
  </div>

  <%= decidim_form_for @form, url: configure_import_path(import_configuration), method: :patch, html: { class: "form form-defaults" } do |form| %>
    <div class="card-section">
      <p><%= t(".placeholder") %></p>

      <ul>
        <li><strong><%= t(".base") %>:</strong> <%= import_configuration.settings&.dig("airtable_base_name").presence || import_configuration.airtable_base_id %></li>
        <li><strong><%= t(".table") %>:</strong> <%= import_configuration.settings&.dig("airtable_table_name").presence || import_configuration.airtable_table_id %></li>
        <li><strong><%= t(".view") %>:</strong> <%= import_configuration.settings&.dig("airtable_view_name").presence || import_configuration.airtable_view_id.presence || "-" %></li>
      </ul>

      <% if @airtable_fields.any? %>
        <% mapped_fields = @form.field_mappings.to_h.with_indifferent_access %>
        <div class="table-stacked">
          <table class="table-list">
            <thead>
              <tr>
                <th><%= t(".airtable_field") %></th>
                <th><%= t(".proposal_field") %></th>
              </tr>
            </thead>
            <tbody>
              <% @airtable_fields.each do |field| %>
                <tr>
                  <td data-label="<%= t(".airtable_field") %>"><%= field[:name] %></td>
                  <td data-label="<%= t(".proposal_field") %>">
                    <% options_html = content_tag(:option, proposal_field_none_option.first, value: proposal_field_none_option.last) %>
                    <% options_html += grouped_options_for_select(proposal_field_option_groups, mapped_fields[field[:id]]) %>
                    <%= select_tag "import_mapping_form[field_mappings][#{field[:id]}]",
                                   options_html,
                                   class: "w-full" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p><%= t(".no_fields") %></p>
      <% end %>
    </div>

    <div class="item__edit-sticky">
      <div class="item__edit-sticky-container">
        <%= form.submit t(".submit"), class: "button button__sm button__secondary" %>
        <%= link_to t(".back"), imports_path, class: "button button__sm button__transparent-secondary" %>
      </div>
    </div>
  <% end %>
</div>
