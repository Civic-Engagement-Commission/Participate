<% add_decidim_page_title(t(".title")) %>

<div class="item_show__header">
  <h1 class="item_show__header-title">
    <%= t(".title") %>
  </h1>
</div>

<div class="item__edit item__edit-1col">
  <div class="item__edit-form">
    <%= decidim_form_for @form, url: imports_path, html: { class: "form form-defaults" } do |form| %>
      <div class="card form__wrapper"
           data-behavior="airtable-import-form"
           data-table-options-url="<%= table_options_imports_path %>"
           data-view-options-url="<%= view_options_imports_path %>">
        <div class="card-section">
          <p><%= t(".placeholder_help") %></p>

          <% if @form.errors.any? %>
            <div class="callout alert">
              <p><%= t(".validation_errors") %></p>
              <ul>
                <% @form.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="row column">
            <%= form.label :airtable_base_id %>

            <% if @available_bases.any? %>
              <%= form.select :airtable_base_id,
                              options_for_select(@available_bases.map { |base| [base[:name], base[:id]] }, @form.airtable_base_id),
                              { prompt: t(".airtable_base_prompt") },
                              { data: { behavior: "airtable-base-input" } } %>
            <% else %>
              <%= form.text_field :airtable_base_id, data: { behavior: "airtable-base-input" } %>
              <p class="help-text"><%= t(".airtable_base_fallback") %></p>
            <% end %>

            <% if @bases_loading_error.present? %>
              <p class="help-text"><%= @bases_loading_error %></p>
            <% end %>
          </div>

          <div class="row column" data-behavior="airtable-table-row">
            <%= form.label :airtable_table_id %>
            <%= form.select :airtable_table_id,
                            options_for_select([], @form.airtable_table_id),
                            { prompt: t(".airtable_table_prompt") },
                            data: { behavior: "airtable-table-input" } %>
            <p class="help-text" data-behavior="airtable-table-help"></p>
          </div>

          <div class="row column" data-behavior="airtable-view-row">
            <%= form.label :airtable_view_id %>
            <%= form.select :airtable_view_id,
                            options_for_select([], @form.airtable_view_id),
                            { prompt: t(".airtable_view_prompt") },
                            data: { behavior: "airtable-view-input" } %>
            <p class="help-text" data-behavior="airtable-view-help"></p>
          </div>

          <div class="row column">
            <%= form.label :active do %>
              <%= form.check_box :active %>
              <%= t(".active_label") %>
            <% end %>
          </div>
        </div>
      </div>

      <div class="item__edit-sticky">
        <div class="item__edit-sticky-container">
          <%= form.submit t(".submit"), class: "button button__sm button__secondary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const formContainer = document.querySelector('[data-behavior="airtable-import-form"]');
    if (!formContainer) return;

    const tableUrl = formContainer.dataset.tableOptionsUrl;
    const viewUrl = formContainer.dataset.viewOptionsUrl;

    const baseInput = formContainer.querySelector('[data-behavior="airtable-base-input"]');
    const tableRow = formContainer.querySelector('[data-behavior="airtable-table-row"]');
    const tableInput = formContainer.querySelector('[data-behavior="airtable-table-input"]');
    const tableHelp = formContainer.querySelector('[data-behavior="airtable-table-help"]');

    const viewRow = formContainer.querySelector('[data-behavior="airtable-view-row"]');
    const viewInput = formContainer.querySelector('[data-behavior="airtable-view-input"]');
    const viewHelp = formContainer.querySelector('[data-behavior="airtable-view-help"]');

    const tablePrompt = '<%= j t(".airtable_table_prompt") %>';
    const viewPrompt = '<%= j t(".airtable_view_prompt") %>';

    const hideDependentRows = () => {
      tableRow.style.display = "none";
      viewRow.style.display = "none";
      tableHelp.textContent = "";
      viewHelp.textContent = "";
    };

    const showTableRow = () => {
      tableRow.style.display = "";
    };

    const showViewRow = () => {
      viewRow.style.display = "";
    };

    const resetSelect = (select, promptText) => {
      select.innerHTML = "";

      const prompt = document.createElement("option");
      prompt.value = "";
      prompt.textContent = promptText;
      select.appendChild(prompt);
    };

    const fillSelect = (select, options, promptText) => {
      resetSelect(select, promptText);

      options.forEach((option) => {
        const element = document.createElement("option");
        element.value = option.id;
        element.textContent = option.name;
        select.appendChild(element);
      });
    };

    const fetchJson = async (url, params) => {
      const query = new URLSearchParams(params);
      const response = await fetch(`${url}?${query.toString()}`, {
        headers: { "Accept": "application/json" }
      });

      if (!response.ok) return [];
      return response.json();
    };

    const loadTables = async () => {
      const baseId = baseInput.value.trim();
      resetSelect(tableInput, tablePrompt);
      resetSelect(viewInput, viewPrompt);
      viewInput.value = "";
      tableHelp.textContent = "";
      viewHelp.textContent = "";

      if (!baseId) {
        tableInput.value = "";
        hideDependentRows();
        return;
      }

      showTableRow();
      const options = await fetchJson(tableUrl, { base_id: baseId });
      fillSelect(tableInput, options, tablePrompt);

      if (tableInput.dataset.selectedValue) {
        tableInput.value = tableInput.dataset.selectedValue;
      }

      if (options.length === 0) {
        tableHelp.textContent = '<%= j t(".no_tables_found") %>';
      }

      if (tableInput.value.trim()) {
        await loadViews();
      } else {
        viewRow.style.display = "none";
      }
    };

    const loadViews = async () => {
      const baseId = baseInput.value.trim();
      const tableId = tableInput.value.trim();
      resetSelect(viewInput, viewPrompt);
      viewHelp.textContent = "";

      if (!baseId || !tableId) {
        viewInput.value = "";
        viewRow.style.display = "none";
        return;
      }

      showViewRow();
      const options = await fetchJson(viewUrl, { base_id: baseId, table_id: tableId });
      fillSelect(viewInput, options, viewPrompt);

      if (viewInput.dataset.selectedValue) {
        viewInput.value = viewInput.dataset.selectedValue;
      }

      if (options.length === 0) {
        viewHelp.textContent = '<%= j t(".no_views_found") %>';
      }
    };

    tableInput.dataset.selectedValue = tableInput.value;
    viewInput.dataset.selectedValue = viewInput.value;

    hideDependentRows();
    baseInput.addEventListener("change", loadTables);
    baseInput.addEventListener("blur", loadTables);
    tableInput.addEventListener("change", loadViews);
    tableInput.addEventListener("blur", loadViews);

    if (baseInput.value.trim()) {
      loadTables();
    }
  });
</script>
